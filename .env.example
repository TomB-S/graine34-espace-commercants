# Example values only, nothing sensitive.
#
# Copy this file to .env (cp .env.example .env) and edit the copy.
# - "npm start" reads .env if it exists (Node option --env-file-if-exists,
#   Node 22.9 or later). Without .env, nothing changes.
# - "node src/server.js" alone does NOT read .env; neither does "npm test".
# - A variable set in front of the command, or exported in the shell, wins
#   over the same variable in .env, even if empty:
#     PORT=8080 npm start
# - .env is ignored by git. Never commit it.
# Every variable is optional, except the CAISSE_* credentials when the page is
# enabled; the defaults are in README.md.

# Address of the Cyclos API (with /api). Without this line the tool targets
# the public Cyclos DEMO (https://demo.cyclos.org/api), not the real instance.
# For real use, uncomment the line and put the address of the real instance:
# CYCLOS_BASE_URL=https://REAL-INSTANCE-ADDRESS/api

# Cyclos channel, sent in the Channel header. Letters, digits, - and _,
# 32 characters at most. Leave empty to send no header.
# Use "main" for professional accounts (without it, Cyclos answers 403/404).
CYCLOS_CHANNEL=main

# Listening port (3001: the statement tool of mission 2A keeps 3000).
PORT=3001

# Session closed after this many minutes without activity.
SESSION_IDLE_MINUTES=20

# Session closed after this many hours, whatever the activity.
SESSION_MAX_HOURS=8

# true only behind HTTPS (Secure cookie + HSTS).
COOKIE_SECURE=false

# ---- Cash register page /caisse (payment notifications) ----
# Off by default: without CAISSE_ENABLED=true, /caisse answers 404 and no
# credential is needed. Names only, no real value. Do not put the password in
# this file: see the "read -s" way of starting in README.md.
# CAISSE_ENABLED=false
# CAISSE_CYCLOS_LOGIN=
# CAISSE_CYCLOS_PASSWORD=
# Account type to read; empty = found automatically.
# CAISSE_ACCOUNT_TYPE=
# Reading rhythm of the page script, in seconds (0 to 60). 0 = manual mode: only the first reading and the Actualiser button read.
# CAISSE_POLL_SECONDS=3
# Page reload for a browser WITHOUT JavaScript, in seconds (2 to 60).
# CAISSE_REFRESH_SECONDS=5
# Listening stops after this many seconds without a visit (15 to 600).
# CAISSE_IDLE_SECONDS=45
# Longest silence on the stream before it is reopened (10 to 600).
# CAISSE_STREAM_WATCHDOG_SECONDS=60
# Longest pause between two reconnection attempts (1 to 600).
# CAISSE_RECONNECT_MAX_SECONDS=30
# Failed logins in a row before the error state (1 to 10).
# CAISSE_REAUTH_MAX=3
# Interval of the periodic safety check, in seconds (10 to 3600).
# CAISSE_SAFETY_POLL_SECONDS=60
# Payments loaded at opening (1 to 100) and kept in memory (1 to 500).
# CAISSE_HISTORY_INITIAL=10
# CAISSE_TICKETS_KEPT=50
# Simultaneous listeners (1 to 50).
# CAISSE_MAX_LISTENERS=5
# true: the payer name is replaced by "Client" on the page.
# CAISSE_HIDE_PAYER_NAME=false
# Order of the words of the payer name in Cyclos. "nom-prenom" (default): "Dupont Marie" is shown "Marie D.";
# "prenom-nom": "Marie Dupont" is shown "Marie D.".
# CAISSE_NAME_ORDER=nom-prenom
# Descriptions not shown on the page (the one the payment type adds when the payer wrote nothing), separated by commas.
# Case, accents and extra spaces do not matter. Not set: "Virement Mobile Pro". Set but empty: nothing is hidden.
# CAISSE_HIDDEN_DESCRIPTIONS=Virement Mobile Pro

# ---- Multi-merchant mode (server only, never in the single executable) ----
# Off by default: nothing below changes anything without CAISSE_MULTI_MERCHANT=true. In this mode every merchant logs in with HIS OWN
# Cyclos account (the password is never kept), CAISSE_CYCLOS_LOGIN and CAISSE_CYCLOS_PASSWORD are not used, and CAISSE_ENABLED=true
# is still needed. Details: docs/multi-commercants.md
# CAISSE_MULTI_MERCHANT=false
# Merchants allowed to open the page, separated by commas: the internal Cyclos number (19 digits, kept as text) or the e-mail
# address (case and surrounding spaces do not matter), as you like for each one. Empty (default) = nobody. Read once at start:
# restart the server after a change. A refused account is written in the log with its internal number, to copy here.
# Example values only: CAISSE_ALLOWED_USERS=1234567890123456789,marie@exemple.test
# CAISSE_ALLOWED_USERS=
# Trusted relays (reverse proxy) between the visitor and this server, 0 to 5. 0: X-Forwarded-For is ignored. 1: one relay.
# The log line "adresse lue ..." at each login shows the address read: adjust until it is the visitor's address.
# CAISSE_TRUSTED_PROXY_HOPS=0
# In this mode CAISSE_MAX_LISTENERS goes from 1 to 200 and defaults to 30 (instead of 1 to 50 and 5).
